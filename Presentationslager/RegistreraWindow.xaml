<Window x:Class="Presentationslager.RegistreraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager"
        mc:Ignorable="d"
        Title="RegistreraWindow" Height="450" Width="800"
        Background= "#6AB">
    <Grid>
        <TextBlock Text="Registrera konto" Margin="0,-200,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="Namn:" Margin="-300,-120,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox x:Name="NamnTextBox" Width="200" Height="25" Margin="0,-120,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <TextBlock Text="Specialisering:" Margin="-300,-60,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <ComboBox x:Name="SpecialiseringComboBox" Width="200" Height="25" Margin="0,-60,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <TextBlock Text="Lösenord:" Margin="-300,-0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <PasswordBox x:Name="LösenordBox" Width="200" Height="25" Margin="0,-0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <TextBlock Text="Bekräfta Lösenord:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-300,60,0,0"/>
        <PasswordBox x:Name="BekräftaLösenordBox" VerticalAlignment="Center" HorizontalAlignment="Center" Height="25" Width="200" Margin="0,60,0,0"/>

        <Button Content="Registrera" Height="25" Width="200" Margin="0,140,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Click="RegistreraButton_Click"/>

        <Button Content="Tillbaka" Height="25" Width="200" Margin="0,200,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Click="TillbakaButton_Click"/>
    </Grid>
</Window>
