<Window x:Class="Presentationslager.Personal.Utlåningshatering.ÅterlämnautlåningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Utlåningshatering"
        mc:Ignorable="d"
        Title="ÅterlämnautlåningWindow" Height="450" Width="800"
        Background="#6ab"
        >
    <Grid>
        <TextBlock Text="Återlämna utlåning" FontSize="25" FontWeight="bold" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Tillängliga utlåningar:" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-550,-240,0,0"/>

        <DataGrid x:Name="AktivutlåningDataGrid" Height="200" Width="350" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-350,0,0,0" SelectionChanged="AktivutlåningDataGrid_SelectionChanged"/>

        <TextBlock Text="Vald utlåningsinformation" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="400,-240,0,0"/>

        <TextBlock Text="Medlem som har lånat:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="150,-180,0,0"/>
        <TextBox x:Name="ValdmedlemTextBox" VerticalAlignment="Center" HorizontalAlignment="Center" Height="25" Width="200" Margin="500,-180,0,0" IsReadOnly="True"/>

        <TextBlock Text="Utlånad utrustning:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="150,-120,0,0"/>
        <TextBox x:Name="ValdutrustningTextBox" VerticalAlignment="Center" HorizontalAlignment="Center" Height="25" Width="200" Margin="500,-120,0,0" IsReadOnly="True"/>

        <TextBlock Text="Välj återlämningsdatum:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="150,60,0,0"/>
        <DatePicker x:Name="Återlämningdatumpicker" Height="25" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="500,60,0,0"/>

        <Button Content="Spara Återlämning" Height="25" Width="200" Margin="500,120,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Click="SparaåterlämningButton_Clic"/>

        <Button Content="TIllbaka" Height="25" Width="200" Margin="500,240,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Click="TillbakaButton_Click"/>

    </Grid>
</Window>
