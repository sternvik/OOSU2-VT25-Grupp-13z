<Window x:Class="Presentationslager.Personal.Medlemshantering.VisamedlemstatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Medlemshantering"
        mc:Ignorable="d"
        Title="VisamedlemstatusWindow" Height="450" Width="800"
        Background="#6ab"
        >
    <Grid>
        <TextBlock Text="Visa medlemstatus" FontSize="25" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Betalstatus:" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-500,-350,0,0"/>
        <ComboBox x:Name="BetalstatusComboBox" Height="25" Width="200" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="-500,-300,0,0" SelectionChanged="BetalstatusComboBox_SelectionChanged"/>

        <DataGrid x:Name="MedlemmarDataGrid" Width="700" Height="250" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Button Content="Tillbaka" Height="25" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,350,0,0" Click="TillbakaButton_Click"/>

    </Grid>
</Window>
