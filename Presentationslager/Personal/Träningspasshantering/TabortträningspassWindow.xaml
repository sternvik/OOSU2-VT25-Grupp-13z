<Window x:Class="Presentationslager.Personal.Träningspasshantering.TabortträningspassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Träningspasshantering"
        mc:Ignorable="d"
        Title="TabortträningspassWindow" Height="450" Width="800"
        Background="#6ab"
        >
    <Grid>
        <TextBlock Text="Ta bort träningspass" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top"/>

        <TextBlock Text="Aktivitets filter:" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-550,-380,0,0"/>
        <ComboBox x:Name="SpecialiseringComboBox" Height="25" Width="200" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="-500,-340,0,0" SelectionChanged="SpecialiseringComboBox_SelectionChanged"/>

        <TextBlock Text="Tillgängliga Träningspass:" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-320,0,0"/>
        <DataGrid x:Name="TräningspassDataGrid" Width="700" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-40,0,0" SelectionChanged="TräningspassDataGrid_SelectionChanged"/>

        <TextBlock Text="Vald Träningspass:" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-600,280,0,0" FontWeight="Bold"/>
        <TextBox x:Name="ValdTräningspassTextBox" IsReadOnly="True" Height="25" Width="200" VerticalContentAlignment="Center" HorizontalAlignment="Center" Margin="-300,280,0,0"/>


        <Button Content="Ta bort" Width="200" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="400,280,0,0" Click="TabortButton_Click"/>
        <Button Content="Tillbaka" Width="200" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="400,360,0,0" Click="TillbakaButton_Click"/>

    </Grid>
</Window>
