<Window x:Class="Presentationslager.Personal.Träningspasshantering.HanteradeltagareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Träningspasshantering"
        mc:Ignorable="d"
        Title="HanteradeltagareWindow" Height="450" Width="800"
        Background="#6ab"
        >
    <Grid>
        <TextBlock Text="Hantera deltagare" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <TextBlock Text="Aktivitets filter:" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-450,-350,0,0"/>
        <ComboBox x:Name="SpecialiseringComboBox" Height="25" Width="200" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="-450,-300,0,0" SelectionChanged="SpecialiseringComboBox_SelectionChanged"/>

        <TextBlock Text="Tillgängliga träningspass:" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-450,-230,0,0"/>
        <DataGrid x:Name="TräningspassDataGrid" Width="250" Height="300" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-450,100,0,0" SelectionChanged="TräningspassDataGrid_SelectionChanged"/>

        <TextBlock Text="Nuvarande Deltagare" FontWeight = "Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="450,-350,0,0"/>
        <ListBox x:Name="DeltagareListBox" Height="150" Width="300" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="450,-150,0,0"/>
        <Button Name="TaBortDeltagareButton" Content="Ta bort vald deltagare" Click="TaBortDeltagareButton_Click" Height="25" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="450,40,0,0"/>

        <TextBlock Text="Lägg till ny deltagare" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="450,120,0,0"/>
        <ComboBox x:Name="MedlemComboBox" Width="300" Height="25" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="450,180,0,0"/>
        <Button Name="LäggtillDeltagareButton" Content="Lägg till Deltagare" Click="LäggtillDeltagareButton_Click" Height="25" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="450,240,0,0"/>

        <Button Name="TillbakaButton" Content="Tillbaka" Click="TillbakaButton_Click" Height="25" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="450,360,0,0"/>

    </Grid>
</Window>
