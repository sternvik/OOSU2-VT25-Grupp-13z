<Window x:Class="Presentationslager.Personal.Träningspasshantering.SkapaträningspassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Träningspasshantering"
        mc:Ignorable="d"
        Title="SkapaträningspassWindow" Height="450" Width="800"
        Background="#6ab"
        >
    <Grid>
        <TextBlock Text="Skapa träningspass" FontSize="25" FontWeight="bold" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Specialiserings filter:" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-400,-350,0,0"/>
        <ComboBox x:Name="SpecialiseringComboBox" Height="25" Width="200" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="-400,-300,0,0" SelectionChanged="SpecialiseringComboBox_SelectionChanged"/>

        <TextBlock Text="Tillgängliga tränare:" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-400,-220,0,0"/>
        <DataGrid x:Name="TränareDataGrid" Width="250" Height="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-400,0,0,0" SelectionChanged="TränareDataGrid_SelectionChanged"/>

        <TextBlock Text="Träningspass information" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="500,-300,0,0"/>

        <TextBlock Text="Tränare:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="200,-180,0,0"/>
        <TextBox x:Name="NamnTextBox" IsReadOnly="True" Height="25" Width="200" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="500,-180,0,0"/>

        <TextBlock Text="Aktivitet:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="200,-120,0,0"/>
        <TextBox x:Name="AktivitetTextBox" IsReadOnly="True" Height="25" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="500,-120,0,0"/>

        <TextBlock Text="Datum:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="200,-60,0,0"/>
        <DatePicker x:Name="StarttidDatePicker" VerticalAlignment="Center" HorizontalAlignment="Center" Height="25" Width="200" Margin="500,-60,0,0"/>

        <TextBlock Text="Starttid:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="200,0,0,0"/>
        <ComboBox x:Name="StarttidComboBox" VerticalAlignment="Center" HorizontalAlignment="Center" Height="25" Width="200" Margin="500,0,0,0"/>

        <TextBlock Text="Plats:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="200,60,0,0"/>
        <ComboBox x:Name="PlatsComboBox" Height="25" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="500,60,0,0"/>

        <Button Content="Spara" Height="25" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="500,120,0,0" Click="SparaButton_Click"/>

        <Button Content="Tillbaka" Height="25" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="500,240,0,0" Click="TillbakaButton_Click"/>
    </Grid>
</Window>
