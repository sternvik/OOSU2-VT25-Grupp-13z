<Window x:Class="Presentationslager.Personal.Rapporter.RapporterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Rapporter"
        mc:Ignorable="d"
        Title="RapporterWindow" Height="450" Width="800"
        Background="#6ab"
        >
    <Grid>
        <TextBlock Text="Rapporter" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-180,0,0"/>
        <Button Content="Utrustningsrapport" Height="25" Width="200" Margin="0,-60,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Click="UtrustningsrapportButton_Click"/>
        <Button Content="Träningspassrapport" Height="25" Width="200" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Click="TräningspassrapportButton_Click"/>
        <Button Content="Tillbaka" Height="25" Width="200" Margin="0,60,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Click="TillbakaButton_Click"/>
    </Grid>
</Window>
