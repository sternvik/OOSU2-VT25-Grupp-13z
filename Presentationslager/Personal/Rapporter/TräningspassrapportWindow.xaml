<Window x:Class="Presentationslager.Personal.Rapporter.TräningspassrapportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Rapporter"
        mc:Ignorable="d"
        Title="TräningspassrapportWindow" Height="450" Width="800"
        Background="#6ab"
        >
    <Grid>
        <TextBlock Text="Träningspassrapport" FontSize="25" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Aktivitets filter:" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-500,-350,0,0"/>
        <ComboBox x:Name="SpecialiseringComboBox" Height="25" Width="200" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="-500,-300,0,0" SelectionChanged="SpecialiseringComboBox_SelectionChanged"/>

        <TextBlock Text="Tillgängliga träningspass:" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-300,-220,0,0"/>
        <DataGrid x:Name="TräningspassDataGrid" Width="400" Height="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-300,0,0,0" SelectionChanged="TräningspassDataGrid_SelectionChanged"/>

        <TextBlock Text="Tränare:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-700,250,0,0"/>
        <TextBox x:Name="TränareTextBox" VerticalAlignment="Center" HorizontalAlignment="Center" Height="25" Width="200" Margin="-450,250,0,0" IsReadOnly="True"/>

        <TextBlock Text="Datum:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-700,320,0,0"/>
        <TextBox x:Name="DatumTextBox" VerticalAlignment="Center" HorizontalAlignment="Center" Height="25" Width="200" Margin="-450,320,0,0" IsReadOnly="True"/>

        <TextBlock Text="Tid:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-200,250,0,0"/>
        <TextBox x:Name="TidTextBox" VerticalAlignment="Center" HorizontalAlignment="Center" Height="25" Width="200" Margin="50,250,0,0" IsReadOnly="True"/>

        <TextBlock Text="Plats:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-200,320,0,0"/>
        <TextBox x:Name="PlatsTextBox" VerticalAlignment="Center" HorizontalAlignment="Center" Height="25" Width="200" Margin="50,320,0,0" IsReadOnly="True"/>

        <TextBlock Text="Deltagare för valt pass:" FontWeight = "Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="450,-220,0,0"/>
        <ListBox x:Name="DeltagareListBox" Height="200" Width="300" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="450,0,0,0"/>

        <Button Content="Tillbaka" Height="25" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="500,320,0,0" Click="TillbakaButton_Click"/>

    </Grid>
</Window>
