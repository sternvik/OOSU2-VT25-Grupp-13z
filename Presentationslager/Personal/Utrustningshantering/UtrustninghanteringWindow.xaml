<Window x:Class="Presentationslager.Personal.Utrustningshantering.UtrustningshanteringWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Utrustningshantering"
        mc:Ignorable="d"
        Title="UtrustningshanteringWindow" Height="450" Width="800"
        Background="#6ab"
        >
    <Grid>
        <TextBlock Text="Utrustningshantering" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-180,0,0"/>
        <Button Content="Registrera utrustning" Height="25" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-60,0,0" Click="RegistreraButton_Click"/>
        <Button Content="Uppdatera utrustning" Height="25" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0" Click="UppdateraButton_Click"/>
        <Button Content="Ta bort utrustning" Height="25" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60,0,0" Click="TabortButton_Click"/>
        <Button Content="Tillbaka" Height="25" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,120,0,0" Click="TillbakaButton_Click"/>
    </Grid>
</Window>
