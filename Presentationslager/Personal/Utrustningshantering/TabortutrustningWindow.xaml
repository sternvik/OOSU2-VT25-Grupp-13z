<Window x:Class="Presentationslager.Personal.Utrustningshantering.TabortutrustningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Utrustningshantering"
        mc:Ignorable="d"
        Title="TabortutrustningWindow" Height="450" Width="800"
        Background="#6ab"
        >
    <Grid>
        <TextBlock Text="Ta bort utrustning" FontSize="25" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Kategorifilter:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-550,-320,0,0" FontWeight="Bold"/>
        <ComboBox x:Name= "KategorifilterComboBox" VerticalAlignment="Center" HorizontalAlignment="center" Margin="-260,-320,0,0" Height="25" Width="200" SelectionChanged="KategorifilterComboBox_SelectionChanged"/>

        <TextBlock Text="Tillgänglig utrustning:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-200,-250,0,0" FontWeight="Bold"/>
        <DataGrid x:Name="UtrustningDataGrid"  Width="500" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-200,20,0,0" SelectionChanged="UtrustningDataGrid_SelectionChanged"/>

        <TextBlock Text="Vald Utrustning:" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="550,-60,0,0" FontWeight="Bold"/>
        <TextBox x:Name="ValdutrustningTextBox" IsReadOnly="True" Height="25" Width="200" VerticalContentAlignment="Center" HorizontalAlignment="Center" Margin="550,0,0,0"/>

        <Button Content="Ta bort" Width="200" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="550,60,0,0" Click="TabortButton_Click"/>
        <Button Content="Tillbaka" Width="200" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="550,180,0,0" Click="TillbakaButton_Click"/>

    </Grid>
</Window>
