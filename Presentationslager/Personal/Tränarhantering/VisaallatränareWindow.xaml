<Window x:Class="Presentationslager.Personal.Tränarhantering.VisaallatränareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager.Personal.Tränarhantering"
        mc:Ignorable="d"
        Title="VisaallatränareWindow" Height="450" Width="800"
        Background="#6ab"
        >
    <Grid>
        <TextBlock Text="Visa alla tränare" FontSize="25" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center"/>

        <TextBlock Text="Specialisering:" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-500,-300,0,0"/>
        <ComboBox x:Name="SpecialiseringComboBox" Height="25" Width="200" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="-200,-300,0,0" SelectionChanged="SpecialiseringComboBox_SelectionChanged"/>

        <DataGrid x:Name="TränareDataGrid" Width="400" Height="250" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Button Content="Tillbaka" Height="25" Width="200" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,350,0,0" Click="TillbakaButton_Click"/>

    </Grid>
</Window>
