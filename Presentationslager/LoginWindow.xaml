<Window x:Class="Presentationslager.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Presentationslager"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800"
        Background= "#6AB"
>

    <Border>

        <Grid>

            <TextBlock Text="Logga in" Margin="0,-150,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Användarnamn:" Margin="-300,-50,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox x:Name="AnvändarenamnTextBox" Width="200" Height="25" Margin="0,-50,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <TextBlock Text="Lösenord:" Margin="-300,20,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <PasswordBox x:Name="LösenordBox" Width="200" Height="25" Margin="0,20,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <Button Content="Logga in" Width="200" Height="25" Margin="0,100,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Click="LoggainButton_Click"/>
            <Button Content="Tillbaka" Height="25" Width="200" Margin="0,160,0,0" VerticalAlignment="Center" HorizontalAlignment="Center" Click="TillbakaButton_Click"/>

        </Grid>
    </Border>

</Window>
